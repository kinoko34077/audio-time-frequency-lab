# Shared specification and implementation: https://github.com/kinoko34077/devflow/issues/1088
# Bootstrap default: LF for portable text; native CRLF for Windows batch scripts.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Original upstream source snapshots and audio/compiled assets remain byte-exact.
upstream/** -text
*.wav -text
*.aiff -text
*.flac -text
*.ogg -text
*.mp3 -text
*.m4a -text
*.wasm -text
